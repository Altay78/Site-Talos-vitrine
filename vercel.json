{
  "trailingSlash": false,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/espace-client.html",
      "destination": "https://app.talos-ai.tech",
      "permanent": false
    },
    {
      "source": "/espace-client",
      "destination": "https://app.talos-ai.tech",
      "permanent": false
    },
    {
      "source": "/fonctionnalites.html",
      "destination": "/offres.html",
      "permanent": true
    },
    {
      "source": "/fonctionnalites",
      "destination": "/offres.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), usb=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    },
    {
      "source": "/(.*).(css|js|svg|png|jpg|jpeg|webp|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, must-revalidate"
        }
      ]
    },
    {
      "source": "/(talos-paiement|panier).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
